---
import '../styles.css';
import icon from '../../../src-tauri/icons/icon.png';

interface Props {
  title: string;
  description?: string;
}

const { title, description = 'usher: a macOS menu-bar app that keeps your highest-ranked audio device active.' } = Astro.props;
// BASE_URL may lack a trailing slash; normalize so links don't glue base and path.
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const nav = [
  { label: 'Home', path: '/' },
  { label: 'Usage', path: '/usage/' },
  { label: 'Changelog', path: '/changelog/' },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/png" href={icon.src} />
    <title>{title}</title>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <header class="site-header">
      <nav aria-label="Main">
        {nav.map((n) => {
          const href = `${base}${n.path}`;
          return <a href={href} aria-current={Astro.url.pathname === href ? 'page' : undefined}>{n.label}</a>;
        })}
        <a href="https://github.com/cef62/usher">GitHub</a>
      </nav>
    </header>
    <main id="main">
      <slot />
    </main>
    <footer class="site-footer">
      <p><a href="https://github.com/cef62/usher">usher</a> · MIT</p>
    </footer>
  </body>
</html>
