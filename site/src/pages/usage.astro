import Base from '../layouts/Base.astro';
import Shot from '../components/Shot.astro';

// Keep in step with README.md (the GitHub-facing copy of the same facts).
const toc = [
  ['install', 'Install'],
  ['panel', 'The panel'],
  ['rank', 'Rank devices'],
  ['auto-switch', 'Auto-switch'],
  ['never-use', 'Never use and Forget'],
  ['usb', 'USB devices that change ports'],
  ['settings', 'Settings'],
  ['updates', 'Updates'],
  ['activity', 'Activity and notices'],
  ['logs', 'Logs and troubleshooting'],
];
const keys = [
  ['Tab', 'Move focus: the Auto-switch switch, the Output list, the Input list, then the footer buttons (Update to usher …, when one is waiting, Activity…, Settings…, Quit). Inside a list, ↑ and ↓ move between rows; a ranked row and its … button share one stop.'],
  ['↑ ↓', 'Move focus to the previous or next row.'],
