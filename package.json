{
  "name": "usher",
  "private": true,
  "version": "0.1.3",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@12.3.4",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "check:size": "node scripts/check-size.mjs",
    "changeset": "changeset",
    "version-packages": "changeset version && node scripts/sync-version.mjs",
    "tauri": "tauri",
    "release:tag": "changeset git-tag",
    "build:app": "tauri build --target aarch64-apple-darwin --bundles app --config '{\"bundle\":{\"createUpdaterArtifacts\":false}}'"
  },
  "devDependencies": {
    "@changesets/cli": "3.0.3",
    "@tauri-apps/cli": "^2.12.4",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "happy-dom": "^20.14.6",
    "typescript": "~7.0.2",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  },
  "dependencies": {
    "@dnd-kit/core": "6.3.1",
    "@dnd-kit/sortable": "10.0.0",
    "@dnd-kit/utilities": "3.2.2",
    "@tauri-apps/api": "^2.12.4",
    "@tauri-apps/plugin-log": "^2.10.2",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  }
}
